<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RegistroEstudianteMAUI.ViewModels"
             xmlns:model="clr-namespace:RegistroEstudianteMAUI.Models"
             x:Class="RegistroEstudianteMAUI.Views.RegistroPage"
             x:DataType="vm:RegistroViewModel"
             Title="Registro de estudiante"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="FormGrid" Property="ColumnDefinitions" Value="*" />
                        <Setter TargetName="FormGrid" Property="RowDefinitions" Value="Auto,Auto" />
                        <Setter TargetName="AcademicColumn" Property="Grid.Row" Value="1" />
                        <Setter TargetName="AcademicColumn" Property="Grid.Column" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="FormGrid" Property="ColumnDefinitions" Value="*,*" />
                        <Setter TargetName="FormGrid" Property="RowDefinitions" Value="Auto" />
                        <Setter TargetName="AcademicColumn" Property="Grid.Row" Value="0" />
                        <Setter TargetName="AcademicColumn" Property="Grid.Column" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border Grid.Row="0" Padding="{OnIdiom Phone='18,22', Tablet='28,24', Desktop='36,28'}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#0B121A}"
                StrokeThickness="0">
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" MaximumWidthRequest="1200">
                <Label Text="Registro de estudiante"
                       FontSize="{OnIdiom Phone=30, Tablet=36, Desktop=40}"
                       FontAttributes="Bold" TextColor="#FFFFFF"
                       HorizontalTextAlignment="Center" HorizontalOptions="Fill"
                       LineBreakMode="WordWrap" />
                <Label Text="Completa tus datos para registrar tu información académica."
                       FontSize="{OnIdiom Phone=15, Tablet=17, Desktop=18}"
                       TextColor="#D6E3EF" HorizontalTextAlignment="Center"
                       HorizontalOptions="Fill" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>
        <ScrollView Grid.Row="1">
            <Grid Padding="{OnIdiom Phone='16,18,16,24', Tablet='0,22,0,28', Desktop='0,24,0,32'}"
                  ColumnDefinitions="{OnIdiom Phone='*', Tablet='5*,90*,5*', Desktop='7.5*,85*,7.5*'}">
            <VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                 Spacing="{OnIdiom Phone=18, Tablet=22, Desktop=24}"
                                 MaximumWidthRequest="1280" HorizontalOptions="Fill">
                <Grid x:Name="FormGrid" RowDefinitions="{OnIdiom Phone='Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                      ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*', Desktop='*,*'}"
                      ColumnSpacing="{OnIdiom Phone=0, Tablet=24, Desktop=32}"
                      RowSpacing="{OnIdiom Phone=20, Tablet=18, Desktop=20}">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="14">
                        <Label Text="Datos personales" FontSize="22" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource TextDark}}"
                               LineBreakMode="WordWrap" />
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nombre completo" Style="{StaticResource FieldLabel}" HorizontalOptions="Fill" />
                            <Entry VerticalTextAlignment="Center" SemanticProperties.Description="Nombre completo" Placeholder="Ingrese su nombre completo" Text="{Binding Nombre}" Keyboard="Text" ReturnType="Next" HorizontalOptions="Fill" />
                            <Label Text="{Binding NombreError}" Style="{StaticResource ErrorLabel}" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Teléfono" Style="{StaticResource FieldLabel}" HorizontalOptions="Fill" />
                            <Entry VerticalTextAlignment="Center" SemanticProperties.Description="Teléfono" Placeholder="Ingrese su número de celular" Text="{Binding Telefono}" Keyboard="Telephone" ReturnType="Next" HorizontalOptions="Fill" />
                            <Label Text="{Binding TelefonoError}" Style="{StaticResource ErrorLabel}" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Fecha" Style="{StaticResource FieldLabel}" HorizontalOptions="Fill" />
                            <DatePicker Date="{Binding Fecha, Mode=TwoWay}" Format="d" SemanticProperties.Description="Fecha del registro" HandlerChanged="FechaHandlerChanged" HorizontalOptions="Fill" />
                            <Label Text="{Binding FechaError}" Style="{StaticResource ErrorLabel}" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="AcademicColumn" Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                         Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}" Spacing="14">
                        <Label Text="Información académica" FontSize="22" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource TextDark}}"
                               LineBreakMode="WordWrap" />
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Correo electrónico" Style="{StaticResource FieldLabel}" HorizontalOptions="Fill" />
                            <Entry VerticalTextAlignment="Center" SemanticProperties.Description="Correo electrónico" Placeholder="Ingrese su correo electrónico" Text="{Binding Correo}" Keyboard="Email" ReturnType="Next" HorizontalOptions="Fill" />
                            <Label Text="{Binding CorreoError}" Style="{StaticResource ErrorLabel}" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Carrera" Style="{StaticResource FieldLabel}" HorizontalOptions="Fill" />
                            <Picker Loaded="CarreraHandlerChanged" HandlerChanged="CarreraHandlerChanged" VerticalTextAlignment="Center" SemanticProperties.Description="Carrera" Title="Selecciona una carrera" ItemsSource="{Binding Carreras}"
                                        SelectedItem="{Binding Carrera}" HorizontalOptions="Fill" />
                            <Label Text="{Binding CarreraError}" Style="{StaticResource ErrorLabel}" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Mensaje}" FontAttributes="Bold" FontSize="14" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource BotonPrimario}" />
                        <Button Grid.Column="1" Text="Limpiar" Command="{Binding LimpiarCommand}" Style="{StaticResource BotonSecundario}" />
                    </Grid>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Estudiantes registrados" FontSize="22" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource TextDark}}"
                           LineBreakMode="WordWrap" />
                    <CollectionView HeightRequest="360" SelectionMode="None" ItemsSource="{Binding Estudiantes}" HorizontalOptions="Fill"
                                    EmptyView="Aún no hay estudiantes registrados.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Estudiante">
                                <Border Style="{StaticResource FieldFrame}" Padding="14" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="17" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Correo}" FontSize="16" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Telefono}" FontSize="16" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Carrera}" FontSize="16" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Fecha, StringFormat='Fecha: {0:dd/MM/yyyy}'}" FontSize="16" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
